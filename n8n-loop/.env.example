# Settings of the loop's own n8n (Agentic Audit Loop). n8n reads them only when it starts.
# start-n8n-loop.cmd loads .env, which is not in git. .env.example is the copy kept in git.
N8N_HOST=localhost
N8N_PORT=5690
N8N_PROTOCOL=http
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_WEBHOOK_URL=http://localhost:5690/
N8N_EDITOR_BASE_URL=http://localhost:5690/
N8N_RUNNERS_BROKER_PORT=5691
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=127.0.0.1
GENERIC_TIMEZONE=Asia/Tokyo
TZ=Asia/Tokyo
N8N_USER_FOLDER=C:\Projects\Agentic_Audit_Loop\n8n-loop\data
N8N_DIAGNOSTICS_ENABLED=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console,file
N8N_LOG_FILE_LOCATION=C:\Projects\Agentic_Audit_Loop\n8n-loop\logs\n8n.log
NODE_OPTIONS=--require=C:\Projects\Agentic_Audit_Loop\n8n-loop\dns-fallback.cjs
# The owner enables the Execute Command node by hand: in .env, add the next line without the "# ".
# NODES_EXCLUDE=["n8n-nodes-base.localFileTrigger"]
